# ============================================
# Smart Career Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# PostgreSQL Database URL (from Neon.tech)
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Secret key for JWT authentication
SECRET_KEY=your-production-secret-key-here

# Optional: Adzuna Job API credentials
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_app_key
